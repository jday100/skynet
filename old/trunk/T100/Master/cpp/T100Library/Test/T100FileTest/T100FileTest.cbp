<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="T100FileTest" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/T100FileTest" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include/file" />
				</Compiler>
				<Linker>
					<Add library="../../../build/libT100File.a" />
					<Add library="../../../build/libT100String.a" />
					<Add library="../../../build/libT100Common.a" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/T100FileTest" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include/file" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add directory="../../Projects/T100Common/include" />
			<Add directory="../../Projects/T100String/include" />
			<Add directory="../../Projects/T100File/include" />
			<Add directory="include" />
		</Compiler>
		<Unit filename="include/file/T100FileTest.h" />
		<Unit filename="main.cpp" />
		<Unit filename="src/file/T100FileTest.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
