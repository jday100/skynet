<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="T100Library" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="../build/T100Library" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-g" />
					<Add directory="include" />
					<Add directory="include/library/common" />
					<Add directory="include/process" />
					<Add directory="include/library/process" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/T100Library" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Release/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-O2" />
					<Add directory="include" />
					<Add directory="include/library/common" />
					<Add directory="include/process" />
					<Add directory="include/library/process" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="include/T100Common.h" />
		<Unit filename="include/library/common/T100Constants.h" />
		<Unit filename="include/library/common/T100DataTypes.h" />
		<Unit filename="include/library/common/T100StringTypes.h" />
		<Unit filename="include/library/process/T100Process.h" />
		<Unit filename="src/library/process/T100Process.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
