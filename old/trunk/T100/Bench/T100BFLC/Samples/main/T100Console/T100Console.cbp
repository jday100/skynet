<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="T100Console" />
		<Option pch_mode="2" />
		<Option compiler="dx9_of_gnu_gcc_compiler" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/T100Console" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="dx9_of_gnu_gcc_compiler" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add library="../../../build/libT100BasicFunctionLibraryC.a" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/T100Console" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="dx9_of_gnu_gcc_compiler" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-nostdinc" />
			<Add option="-nostdinc++" />
			<Add directory="../../../Source/T100BasicFunctionLibraryC/include" />
		</Compiler>
		<Linker>
			<Add option="-nostartfiles" />
			<Add option="-nodefaultlibs" />
			<Add option="-nostdlib" />
			<Add option="-e__start" />
		</Linker>
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
