<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="T100Editor" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/T100Editor" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D__WXDEBUG__" />
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
					<Add directory="include" />
					<Add directory="../T100Editor" />
					<Add directory="include/editor" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
				</ResourceCompiler>
				<Linker>
					<Add library="../build/libT100Main.a" />
					<Add library="libwxmsw30ud.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/T100Editor" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
					<Add directory="include" />
					<Add directory="../T100Editor" />
					<Add directory="include/editor" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-s" />
					<Add library="libwxmsw30u.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
			<Target title="Library">
				<Option output="../build/plugins/T100Editor" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D__WXDEBUG__" />
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
					<Add directory="include" />
					<Add directory="../T100Editor" />
					<Add directory="include/editor" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
				</ResourceCompiler>
				<Linker>
					<Add library="../build/libT100Main.a" />
					<Add library="libwxmsw30ud.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-pipe" />
			<Add option="-mthreads" />
			<Add option="-D__GNUWIN32__" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DwxUSE_UNICODE" />
			<Add directory="$(#wx)/include" />
			<Add directory="../T100Main" />
			<Add directory="../T100Main/include" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#wx)/include" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
		</Linker>
		<Unit filename="T100EditorApp.cpp">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="T100EditorApp.h">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="T100EditorMain.cpp" />
		<Unit filename="T100EditorMain.h" />
		<Unit filename="include/editor/T100Editor.h" />
		<Unit filename="include/editor/T100EditorPanel.h" />
		<Unit filename="include/editor/T100PluginEditorActuator.h" />
		<Unit filename="main.cpp" />
		<Unit filename="main.h" />
		<Unit filename="resource.rc">
			<Option compilerVar="WINDRES" />
		</Unit>
		<Unit filename="src/editor/T100Editor.cpp" />
		<Unit filename="src/editor/T100EditorPanel.cpp" />
		<Unit filename="src/editor/T100PluginEditorActuator.cpp" />
		<Unit filename="wxsmith/T100EditorPanel.wxs" />
		<Unit filename="wxsmith/T100Editorframe.wxs" />
		<Extensions>
			<wxsmith version="1">
				<gui name="wxWidgets" src="T100EditorApp.cpp" main="T100EditorFrame" init_handlers="necessary" language="CPP" />
				<resources>
					<wxFrame wxs="wxsmith/T100Editorframe.wxs" src="T100EditorMain.cpp" hdr="T100EditorMain.h" fwddecl="0" i18n="1" name="T100EditorFrame" language="CPP" />
					<wxPanel wxs="wxsmith/T100EditorPanel.wxs" src="src\editor\T100EditorPanel.cpp" hdr="include\editor\T100EditorPanel.h" fwddecl="0" i18n="1" name="T100EditorPanel" language="CPP" />
				</resources>
			</wxsmith>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
