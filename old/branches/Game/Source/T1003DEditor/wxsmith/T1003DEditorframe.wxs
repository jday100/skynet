<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="T1003DEditorFrame">
		<handler function="OnKeyDown" entry="EVT_KEY_DOWN" />
		<handler function="OnKeyUp" entry="EVT_KEY_UP" />
		<handler function="OnChar" entry="EVT_CHAR" />
		<handler function="OnMouseMove" entry="EVT_MOTION" />
		<object class="wxMenuBar" variable="MenuBar1" member="no">
			<object class="wxMenu" variable="Menu1" member="no">
				<label>&amp;File</label>
				<object class="wxMenuItem" name="ID_MENU_NEW" variable="MenuItemNew" member="yes">
					<label>New</label>
					<handler function="OnMenuItemNewSelected" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="ID_MENU_OPEN" variable="MenuItemOpen" member="yes">
					<label>Open</label>
					<handler function="OnMenuItemOpenSelected" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM3" variable="MenuItem5" member="yes">
					<label>Close</label>
				</object>
				<object class="separator" />
				<object class="wxMenuItem" name="ID_MENU_SAVE" variable="MenuItemSave" member="yes">
					<label>Save</label>
					<handler function="OnMenuItemSaveSelected" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM5" variable="MenuItem7" member="yes">
					<label>Save As</label>
				</object>
				<object class="separator" />
				<object class="wxMenuItem" name="idMenuQuit" variable="MenuItem1" member="no">
					<label>Quit</label>
					<accel>Alt-F4</accel>
					<help>Quit the application</help>
					<handler function="OnQuit" entry="EVT_MENU" />
				</object>
			</object>
			<object class="wxMenu" variable="Menu3" member="yes">
				<label>Settings</label>
				<object class="wxMenuItem" name="ID_MENUITEM_CONFIG" variable="MenuItemConfig" member="yes">
					<label>Config</label>
					<handler function="OnMenuItemConfigSelected" entry="EVT_MENU" />
				</object>
			</object>
			<object class="wxMenu" variable="Menu2" member="no">
				<label>Help</label>
				<object class="wxMenuItem" name="idMenuAbout" variable="MenuItem2" member="no">
					<label>About</label>
					<accel>F1</accel>
					<help>Show info about this application</help>
					<handler function="OnAbout" entry="EVT_MENU" />
				</object>
			</object>
		</object>
		<object class="wxStatusBar" name="ID_STATUSBAR1" variable="StatusBar1" member="yes">
			<fields>1</fields>
			<widths>-1</widths>
			<styles>wxSB_NORMAL</styles>
		</object>
