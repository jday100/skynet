<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="T100Game" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/T100Game" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D__WXDEBUG__" />
					<Add option="-D_XM_NO_INTRINSICS_" />
					<Add option="-DNDEBUG" />
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
					<Add directory="include/link" />
					<Add directory="include/data" />
					<Add directory="include" />
					<Add directory="../../../T100Native/Projects/T1003DRenderer/include" />
					<Add directory="../../../T100Native/Projects/T100DX12Renderer/include" />
					<Add directory="../../../T100Native/Projects/T100Core/include" />
					<Add directory="include/tools" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
				</ResourceCompiler>
				<Linker>
					<Add library="libwxmsw30ud.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/T100Game" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
					<Add directory="include/link" />
					<Add directory="include/data" />
					<Add directory="include" />
					<Add directory="include/tools" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-s" />
					<Add library="libwxmsw30u.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
			<Target title="Library">
				<Option output="../build/T100Game" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D__WXDEBUG__" />
					<Add option="-D_XM_NO_INTRINSICS_" />
					<Add option="-DNDEBUG" />
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
					<Add directory="include/link" />
					<Add directory="include/data" />
					<Add directory="include" />
					<Add directory="../../../T100Native/Projects/T1003DRenderer/include" />
					<Add directory="../../../T100Native/Projects/T100DX12Renderer/include" />
					<Add directory="../../../T100Native/Projects/T100Core/include" />
					<Add directory="../../../T100Library/Projects/T100Math/include" />
					<Add directory="include/tools" />
					<Add directory="../../third" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswud" />
				</ResourceCompiler>
				<Linker>
					<Add library="libwxmsw30ud.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-pipe" />
			<Add option="-mthreads" />
			<Add option="-D__GNUWIN32__" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-Wall" />
			<Add directory="$(#wx)/include" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#wx)/include" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
		</Linker>
		<Unit filename="T100GameApp.cpp">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="T100GameApp.h">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="T100GameMain.cpp">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="T100GameMain.h">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="include/T100Game.h" />
		<Unit filename="include/T100GameInput.h" />
		<Unit filename="include/T100GameMotion.h" />
		<Unit filename="include/data/T100GameScene.h" />
		<Unit filename="include/link/T100Scene.h" />
		<Unit filename="include/tools/T100GameTools.h" />
		<Unit filename="resource.rc">
			<Option compilerVar="WINDRES" />
		</Unit>
		<Unit filename="src/T100Game.cpp" />
		<Unit filename="src/T100GameInput.cpp" />
		<Unit filename="src/T100GameMotion.cpp" />
		<Unit filename="src/data/T100GameScene.cpp" />
		<Unit filename="src/link/T100Scene.cpp" />
		<Unit filename="src/tools/T100GameTools.cpp" />
		<Unit filename="wxsmith/T100Gameframe.wxs" />
		<Extensions>
			<lib_finder disable_auto="1" />
			<wxsmith version="1">
				<gui name="wxWidgets" src="T100GameApp.cpp" main="T100GameFrame" init_handlers="necessary" language="CPP" />
				<resources>
					<wxFrame wxs="wxsmith/T100Gameframe.wxs" src="T100GameMain.cpp" hdr="T100GameMain.h" fwddecl="0" i18n="1" name="T100GameFrame" language="CPP" />
				</resources>
			</wxsmith>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
