				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D__WXDEBUG__" />
					<Add option="-D_XM_NO_INTRINSICS_" />
					<Add option="-DUNICODE" />
