<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="T100Plugin" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/T100Plugin" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include/plugin" />
				</Compiler>
				<Linker>
					<Add library="../../../build/libT100DynamicLibrary.a" />
					<Add library="../../../build/libT100Library.a" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/T100Plugin" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include/plugin" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Library">
				<Option output="../../../build/T100Plugin" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include/plugin" />
				</Compiler>
				<Linker>
					<Add library="../../../build/libT100DynamicLibrary.a" />
					<Add library="../../../build/libT100Library.a" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="../../../T100Library/Source/T100Library/include" />
			<Add directory="../../../T100Native/windows/Projects/T100DynamicLibrary/include" />
			<Add directory="include" />
		</Compiler>
		<Linker>
			<Add library="gdi32" />
			<Add library="user32" />
			<Add library="kernel32" />
			<Add library="comctl32" />
		</Linker>
		<Unit filename="include/plugin/T100Plugin.h" />
		<Unit filename="include/plugin/T100PluginServer.h" />
		<Unit filename="main.cpp">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="src/plugin/T100Plugin.cpp" />
		<Unit filename="src/plugin/T100PluginServer.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
