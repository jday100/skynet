<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="T100Compiler" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/T100Compiler" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include/compiler/base" />
					<Add directory="include/compiler/data" />
					<Add directory="include/compiler/scanner" />
					<Add directory="include/compiler/common" />
					<Add directory="include/compiler/classifier" />
				</Compiler>
				<Linker>
					<Add library="../../../build/libT100File.a" />
					<Add library="../../../build/libT100Common.a" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/T100Compiler" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include/compiler/base" />
					<Add directory="include/compiler/data" />
					<Add directory="include/compiler/scanner" />
					<Add directory="include/compiler/common" />
					<Add directory="include/compiler/classifier" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Library">
				<Option output="../../../build/T100Compiler" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include/compiler/base" />
					<Add directory="include/compiler/data" />
					<Add directory="include/compiler/scanner" />
					<Add directory="include/compiler/common" />
					<Add directory="include/compiler/classifier" />
				</Compiler>
				<Linker>
					<Add library="../../../build/libT100Common.a" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add directory="../T100Common/include" />
			<Add directory="../T100Vessel/include" />
			<Add directory="../T100File/include" />
			<Add directory="include" />
		</Compiler>
